# API Gateway Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Chat Service Configuration
CHAT_SERVICE_URL=http://localhost:3001
CHAT_SERVICE_TIMEOUT=30000

# Image Service Configuration
IMAGE_SERVICE_URL=http://localhost:3002
IMAGE_SERVICE_TIMEOUT=60000

# TTS/STT Service Configuration
TTS_SERVICE_URL=http://localhost:3003
TTS_SERVICE_TIMEOUT=30000

# LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama2

# Image Generation Configuration
STABLE_DIFFUSION_URL=http://localhost:7860
STABLE_DIFFUSION_MODEL=runwayml/stable-diffusion-v1-5

# TTS/STT Configuration
WHISPER_MODEL=base
COQUI_TTS_URL=http://localhost:5002
